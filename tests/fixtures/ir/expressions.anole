@a: 5;
@b: 2;
@empty;
@decimal: 1.25;
@text: "hi";
@flag: true;
@items: [a, b, 3];
@table: dict { "x" => a, b => 2 };
@negative: -a;
@logical: not false and true or false;
@bits: a & b | a ^ b;
@shifts: a << b >> b;
@arithmetic: [a + b, a - b, a * b, a / b, a % b];
@inverted: ~a;
@bit_constant: 1 & 3;
@folded: [1 + 2, 5 - 3, 2 * 4, 8 / 2, 9 % 4, 1 < 2, 2 >= 1, 1 and 0];
@unicode: "é"; @after_unicode: a;
@comparisons: [a is b, a = b, a != b, a < b, a <= b, a > b, a >= b];
@choice: flag ? a, b;
@later: delay a + b;
@member: text.size;
@indexed: items[0];
@fun: @(x: a, &y: b, ...rest) { return x, y; };
@count: fun(1, 2, [3, 4]...);
@identity(value): value;
prefixop identity;
@combine(left, right): left + right;
infixop 75 combine;
@custom: identity 3 combine 4;
@block_value: { @inside: 9; };
